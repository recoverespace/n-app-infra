# Local service settings
ENV_FILE=".env.dev"
TRAEFIK_DOMAIN="api.dev.example.com"
TRAEFIK_STACK="dev"
TRAEFIK_ACME_EMAIL="dev@recoveredspace.com"
TRAEFIK_LOG_LEVEL="INFO"

# Docker Compose network hostnames
REDIS_DSN=redis://redis:6379/1
CENTRIFUGE_INTERNAL_HOST="centrifugo:8008"
CENTRIFUGE_WORKER_HOST="centrifugo:8010"
PYTHONUNBUFFERED=1
PG_USER="postgres"
PG_PASSWORD="postgres"
PG_HOST="postgres"
PG_PORT=5432
PG_SCHEMA="backend"

CENTRIFUGE_SCHEMA="http"
CENTRIFUGE_WS_SCHEMA="ws"
CENTRIFUGE_API_KEY="sb3b3b3b3-b3b3-b3b3-b3b3-b3b3b3b3b3b"
CENTRIFUGO_HTTP_API_KEY=sb3b3b3b3-b3b3-b3b3-b3b3-b3b3b3b3b3b
CENTRIFUGE_SECRET=b3b3b3b3-b3b3-b3b3-b3b3-b3b3b3b3b3b 
CENTRIFUGO_TOKEN_HMAC_SECRET_KEY=b3b3b3b3-b3b3-b3b3-b3b3-b3b3b3b3b3b
CENTRIFUGE_TOKEN_TTL=3600
CENTRIFUGE_CHAT_NAMESPACE_TEMPLATE="chat:messages#{}"  # Dev: "chat-dev:messages#{}"

# External Access
EXTERNAL_URL="http://localhost:8000"
CENTRIFUGE_HOST="centrifuge:8010"

# Reporting settings
REPORTING_API_KEY="reporting_api_key"


# LLM Chat settings
CHAT_URL="https://aichat-dev-apim-t55fh.azure-api.net/api/flexible-rag"
CHAT_OAUTH_CLIENT_ID=""
CHAT_OAUTH_CLIENT_SECRET=""
CHAT_OAUTH_TENANT_ID=""
CHAT_OAUTH_SCOPE="api://rcv-chat-api/.default"
CHAT_OAUTH_SUBSCRIPTION_KEY=""
CHAT_MAX_MESSAGE_HISTORY=99999
CHAT_MAX_FACT_HISTORY=99999
CHAT_RECENT_FACT_DAYS=5

# Monitoring

SERVICE_PREFIX=""
OTEL_AUTH_TOKEN=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_ENDPOINT=

# Auth credentials

SECRET_KEY="VERY_SECRET_KEY"
ACCESS_TOKEN_EXPIRE_SECONDS=3600
REFRESH_TOKEN_EXPIRE_SECONDS=2592000

FIREBASE_CERTIFICATE=""

# Resend (email delivery for magic link)
RESEND_API_KEY=""
RESEND_FROM="email@uthriveapp.com"
RESEND_REPLY_TO=""
RESEND_SUBJECT_PREFIX=""

# Firebase email-link sign-in settings (magic link)
FIREBASE_EMAIL_LINK_ANDROID_PACKAGE="com.app.napp"
FIREBASE_EMAIL_LINK_IOS_BUNDLE_ID="com.app.napp"
FIREBASE_EMAIL_LINK_CONTINUE_PATH="/v1/auth/email-link-login"

# Abuse protection for magic-link endpoint
AUTH_MAGIC_LINK_RATE_LIMIT_PER_IP=10
AUTH_MAGIC_LINK_RATE_LIMIT_PER_EMAIL=5
AUTH_MAGIC_LINK_RATE_LIMIT_WINDOW_SECONDS=600

# Third-party service settings

ONESIGNAL_APP_ID=""
ONESIGNAL_API_KEY=""

STORYBLOK_TOKEN=""
STORYBLOK_MAPI_TOKEN=""

STRIPE_ACCOUNT_ID=""
STRIPE_API_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

GSPREAD_USERS_URL=""
FEEL2HEAL_USERS_URL="https://docs.google.com/spreadsheets/d/1aYLF2TLxMaS9fKF8cUL1m47gRRX2CVogzFNMBiyBcwc"
GSPREAD_SERVICE_ACCOUNT_FILE=""
GSPREAD_SERVICE_ACCOUNT_JSON="{}"

# Circle.so settings
CIRCLE_ADMIN_API_KEY=""
CIRCLE_HEADLESS_API_KEY=""
CIRCLE_SPACE_ID=""

# Metabase configuration
METABASE_ENABLED=false
METABASE_HOST=metabase.dev.example.com
METABASE_SITE_URL=https://metabase.dev.example.com
METABASE_DB_TYPE="postgres"
METABASE_DB_NAME="metabase"
METABASE_DB_HOST="postgres"
METABASE_DB_PORT=5432
METABASE_DB_USER="metabase"
METABASE_DB_PASSWORD="metabase"
METABASE_IMAGE="metabase/metabase:v0.50.6"
METABASE_JAVA_TOOL_OPTIONS="-Xmx512m"
METABASE_ENABLE_EMBEDDING=false
METABASE_EMBEDDING_APP_ORIGIN=""
METABASE_BASE_URL="http://metabase:3000"
METABASE_ADMIN_EMAIL=""
